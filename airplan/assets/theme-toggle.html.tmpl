<div class="appearance js-only" hidden>
  <button class="appearance-trigger" type="button"
    data-airplan-appearance-trigger aria-expanded="false"
    aria-controls="airplan-appearance-panel" aria-label="Appearance"
    title="Appearance"><svg class="icon" aria-hidden="true"
    viewBox="0 0 16 16" fill="none" stroke="currentColor"
    stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle
    cx="8" cy="8" r="2.25"/><path
    d="M8 1v1.25M8 13.75V15M1 8h1.25M13.75 8H15M3.05 3.05l.88.88M12.07 12.07l.88.88M12.95 3.05l-.88.88M3.93 12.07l-.88.88"/></svg></button>
  <div class="appearance-panel" id="airplan-appearance-panel"
    data-airplan-appearance-panel role="group" aria-label="Appearance settings"
    hidden>
    <div class="appearance-heading">Appearance</div>
    <div class="appearance-field">
      <span class="appearance-label" id="airplan-mode-label">Mode</span>
      <div class="mode-toggle appearance-modes" role="group"
        aria-labelledby="airplan-mode-label">
        <button type="button" data-airplan-color-mode="system"
          aria-pressed="true">System</button>
        <button type="button" data-airplan-color-mode="light"
          aria-pressed="false">Light</button>
        <button type="button" data-airplan-color-mode="dark"
          aria-pressed="false">Dark</button>
      </div>
    </div>
    <label class="appearance-field" for="airplan-light-theme">
      <span class="appearance-label">Light mode theme</span>
      <select id="airplan-light-theme" data-airplan-theme-slot="light"></select>
    </label>
    <label class="appearance-field" for="airplan-dark-theme">
      <span class="appearance-label">Dark mode theme</span>
      <select id="airplan-dark-theme" data-airplan-theme-slot="dark"></select>
    </label>
  </div>
</div>
