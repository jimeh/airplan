<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
{{- if or (eq .Format "md") .VersionsPath}}
<meta name="airplan-versions" content="{{if .VersionsPath}}{{.VersionsPath}}{{else}}.airplan-versions.json{{end}}">
{{- if .Revision}}
<meta name="airplan-revision" content="{{.Revision}}">
<meta name="airplan-revision-chain" content="{{.RevisionChainID}}">
<meta name="airplan-page-path" content="{{.CurrentPage.Path}}">
<meta name="airplan-entrypoint" content="{{.Entrypoint}}">
{{- end}}
{{- end}}
{{- if not .Indexable}}
<meta name="robots" content="noindex, nofollow">
{{- end}}
<title>{{.Title}}</title>
<script>window.__AIRPLAN_THEME_CATALOG__={{.ThemeCatalogJSON}};</script>
<script>
/* airplan:theme-init-js */
</script>
<style>
/* airplan:page-css */
{{.ThemeCSS}}
{{.SyntaxCSS}}
</style>
</head>
<body>
<div class="page-shell{{if gt (len .Pages) 1}} bundle-page{{end}}">
<nav class="toolbar" aria-label="Document controls">
{{- if gt (len .Pages) 1}}
  <button type="button" class="pages-trigger js-only" hidden
    aria-label="Open pages" aria-controls="pages-popover"><svg class="icon" aria-hidden="true"
    viewBox="0 0 16 16" fill="none" stroke="currentColor"
    stroke-width="1.5" stroke-linecap="round"><path d="M3 3.25h10M3 8h10M3 12.75h10"/><circle cx="1" cy="3.25" r=".6" fill="currentColor" stroke="none"/><circle cx="1" cy="8" r=".6" fill="currentColor" stroke="none"/><circle cx="1" cy="12.75" r=".6" fill="currentColor" stroke="none"/></svg><span>Pages</span></button>
{{- end}}
{{- if or (and (eq .Format "md") .HighlightedSourceHTML) .SourcePath}}
  <div class="file-actions toolbar-actions{{if not .SourcePath}} js-only{{end}}"{{if not .SourcePath}} hidden{{end}}>
{{- if and (eq .Format "md") .HighlightedSourceHTML}}
  <button type="button" class="copy-source js-only" hidden
    aria-label="Copy markdown" title="Copy markdown"><svg
    class="icon icon-copy" aria-hidden="true" viewBox="0 0 16 16"
    fill="currentColor"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"/><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"/></svg><svg
    class="icon icon-check" aria-hidden="true" viewBox="0 0 16 16"
    fill="currentColor"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/></svg><svg
    class="icon icon-x" aria-hidden="true" viewBox="0 0 16 16"
    fill="currentColor"><path d="M3.72 3.72a.75.75 0 0 1 1.06 0L8 6.94l3.22-3.22a.749.749 0 0 1 1.275.326.749.749 0 0 1-.215.734L9.06 8l3.22 3.22a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L8 9.06l-3.22 3.22a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042L6.94 8 3.72 4.78a.75.75 0 0 1 0-1.06Z"/></svg><span class="action-label">Copy</span></button>
{{- end}}
{{- if .SourcePath}}
  <a class="download" href="{{.SourcePath}}" download
    aria-label="Download {{if eq .Format "md"}}markdown{{else}}source{{end}}"
    title="Download {{if eq .Format "md"}}markdown{{else}}source{{end}}"><svg
    class="icon" aria-hidden="true" viewBox="0 0 16 16"
    fill="currentColor"><path d="M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14Z"/><path d="M7.25 7.689V2a.75.75 0 0 1 1.5 0v5.689l1.97-1.969a.749.749 0 1 1 1.06 1.06l-3.25 3.25a.749.749 0 0 1-1.06 0L4.22 6.78a.749.749 0 1 1 1.06-1.06l1.97 1.969Z"/></svg><span>Download</span></a>
  <a class="raw" href="{{.SourcePath}}"
    aria-label="Open raw {{if eq .Format "md"}}markdown{{else}}source{{end}}"
    title="Open raw {{if eq .Format "md"}}markdown{{else}}source{{end}}"><svg
    class="icon" aria-hidden="true" viewBox="0 0 16 16"
    fill="currentColor"><path d="m11.28 3.22 4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734L13.94 8l-3.72-3.72a.749.749 0 0 1 .326-1.275.749.749 0 0 1 .734.215Zm-6.56 0a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042L2.06 8l3.72 3.72a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L.47 8.53a.75.75 0 0 1 0-1.06Z"/></svg><span>Raw</span></a>
{{- end}}
  </div>
{{- end}}
{{- if .AppearanceEnabled}}
<!-- airplan:theme-toggle -->
{{- end}}
</nav>
{{- if gt (len .Pages) 1}}
<nav class="pages-nav" id="pages" aria-label="Pages">
  <p class="rail-title">Pages</p>
  <ol class="pages-list">
  {{- range .Pages}}
    <li{{if .Current}} class="is-current"{{end}}>
      <a href="{{.URL}}"{{if .Current}} aria-current="page"{{end}}>
        <span class="page-title">{{.Title}}</span>
        <code class="page-path">{{.Path}}</code>
      </a>
    </li>
  {{- end}}
  </ol>
</nav>
{{- end}}
{{- if .TOC}}
<nav class="toc" id="toc" aria-label="Table of contents">
  <p class="rail-title toc-title">{{if gt (len .Pages) 1}}On this page{{else}}Contents{{end}}</p>
  <ol class="toc-list">
  {{- range .TOC}}
    <li class="toc-level-{{.Level}}"><a href="#{{.ID}}">{{.Text}}</a></li>
  {{- end}}
  </ol>
</nav>
{{- end}}
{{- if or .Revision (and (eq .Format "md") .HighlightedSourceHTML) .PageChanged}}
<section class="reader-controls" aria-label="Revision and content controls">
{{- if or (and (eq .Format "md") .HighlightedSourceHTML) (and (eq .Format "txt") .Revision)}}
  <div class="viewtoggle mode-toggle js-only" hidden>
    <button type="button" class="active" data-view="rendered"
      aria-pressed="true" aria-label="{{if eq .Format "md"}}Rendered{{else}}Code{{end}} view"
      title="{{if eq .Format "md"}}Rendered{{else}}Code{{end}} view">{{if eq .Format "md"}}<svg class="icon" aria-hidden="true"
      viewBox="0 0 16 16" fill="currentColor"><path d="M8 2c1.981 0 3.671.992 4.933 2.078 1.27 1.091 2.187 2.345 2.637 3.023a1.62 1.62 0 0 1 0 1.798c-.45.678-1.367 1.932-2.637 3.023C11.67 13.008 9.981 14 8 14c-1.981 0-3.671-.992-4.933-2.078C1.797 10.83.88 9.576.43 8.898a1.62 1.62 0 0 1 0-1.798c.45-.677 1.367-1.931 2.637-3.022C4.33 2.992 6.019 2 8 2ZM1.679 7.932a.12.12 0 0 0 0 .136c.411.622 1.241 1.75 2.366 2.717C5.176 11.758 6.527 12.5 8 12.5c1.473 0 2.825-.742 3.955-1.715 1.124-.967 1.954-2.096 2.366-2.717a.12.12 0 0 0 0-.136c-.412-.621-1.242-1.75-2.366-2.717C10.824 4.242 9.473 3.5 8 3.5c-1.473 0-2.825.742-3.955 1.715-1.124.967-1.954 2.096-2.366 2.717ZM8 10a2 2 0 1 1-.001-3.999A2 2 0 0 1 8 10Z"/></svg>{{else}}<svg class="icon" aria-hidden="true"
      viewBox="0 0 16 16" fill="currentColor"><path d="m11.28 3.22 4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734L13.94 8l-3.72-3.72a.749.749 0 0 1 .326-1.275.749.749 0 0 1 .734.215Zm-6.56 0a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042L2.06 8l3.72 3.72a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L.47 8.53a.75.75 0 0 1 0-1.06Z"/></svg>{{end}}<span>{{if eq .Format "md"}}Rendered{{else}}Code{{end}}</span></button>
    {{- if eq .Format "md"}}
    <button type="button" data-view="source" aria-pressed="false"
      aria-label="Source view" title="Source view"><svg class="icon" aria-hidden="true"
      viewBox="0 0 16 16" fill="currentColor"><path d="m11.28 3.22 4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734L13.94 8l-3.72-3.72a.749.749 0 0 1 .326-1.275.749.749 0 0 1 .734.215Zm-6.56 0a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042L2.06 8l3.72 3.72a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L.47 8.53a.75.75 0 0 1 0-1.06Z"/></svg><span>Source</span></button>
    {{- end}}
    {{- if .PageChanged}}
    <button type="button" data-view="changes" aria-pressed="false"
      aria-label="Changes view" title="Changes from revision {{.PreviousRevision}}"><span>Changes</span></button>
    {{- end}}
  </div>
{{- end}}
{{- if .Revision}}
  <div class="revision-controls">
    <p class="revision-heading" data-revision-heading>Revision {{.Revision}}{{if .RevisionCount}} of {{.RevisionCount}}{{end}}</p>
    {{- if gt .Revision 1}}
    <a class="all-changes-link" href="{{.AllChangesPath}}">All changes</a>
    {{- end}}
  </div>
{{- end}}
</section>
{{- end}}
<main class="content" id="rendered">
{{- if and (eq .Format "txt") .SourceName}}
<div class="filehead"><code>{{.SourceName}}</code></div>
{{- end}}
{{- if and (eq .Format "md") .HighlightedFrontMatterHTML}}
<details class="frontmatter">
  <summary>Frontmatter <span>{{.FrontMatterFormat}}</span></summary>
  {{.HighlightedFrontMatterHTML}}
</details>
{{- end}}
{{.RenderedHTML}}
{{- if gt (len .Pages) 1}}
{{- $current := .CurrentPage}}
{{- $previous := .CurrentPage}}
{{- $next := .CurrentPage}}
{{- $foundCurrent := false}}
{{- $foundNext := false}}
{{- range .Pages}}
  {{- if .Current}}
    {{- $foundCurrent = true}}
  {{- else if not $foundCurrent}}
    {{- $previous = .}}
  {{- else if not $foundNext}}
    {{- $next = .}}
    {{- $foundNext = true}}
  {{- end}}
{{- end}}
<nav class="page-sequence" aria-label="Page sequence">
  {{- if ne $previous.Path $current.Path}}
  <a class="page-sequence-link page-sequence-previous" href="{{$previous.URL}}">
    <span class="page-sequence-direction">Previous</span>
    <span class="page-sequence-title">{{$previous.Title}}</span>
  </a>
  {{- end}}
  {{- if ne $next.Path $current.Path}}
  <a class="page-sequence-link page-sequence-next" href="{{$next.URL}}">
    <span class="page-sequence-direction">Next</span>
    <span class="page-sequence-title">{{$next.Title}}</span>
  </a>
  {{- end}}
</nav>
{{- end}}
</main>
{{- if .PageChanged}}
<main class="content changes-view" id="changes" hidden>
<h1 class="changes-heading">Changes to {{.CurrentPage.Path}} from revision {{.PreviousRevision}}</h1>
{{- if .HighlightedPageDiffHTML}}
{{.HighlightedPageDiffHTML}}
{{- else}}
<p>This diff is too large to display inline.</p>
{{- end}}
<p><a class="raw-diff" href="{{.DiffPath}}">Open raw diff</a></p>
</main>
{{- end}}
{{- if and (eq .Format "md") .HighlightedSourceHTML}}
<main class="content source-view" id="source" hidden>
<p class="source-heading"><svg class="icon" aria-hidden="true"
  viewBox="0 0 16 16" fill="currentColor"><path d="m11.28 3.22 4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734L13.94 8l-3.72-3.72a.749.749 0 0 1 .326-1.275.749.749 0 0 1 .734.215Zm-6.56 0a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042L2.06 8l3.72 3.72a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L.47 8.53a.75.75 0 0 1 0-1.06Z"/></svg><span>Markdown source</span></p>
{{.HighlightedSourceHTML}}
</main>
{{- end}}
{{- if .HasCompleteDiff}}
<main class="content all-changes-view" data-airplan-all-changes hidden>
<nav class="all-changes-actions" aria-label="All changes actions"><a href="{{.Entrypoint}}">Back to document</a><span aria-hidden="true">·</span><a class="raw-diff" href="{{.DiffPath}}">Open raw diff</a></nav>
<h1 tabindex="-1">All changes from revision {{.PreviousRevision}}</h1>
{{- if .HighlightedCompleteDiffHTML}}
{{.HighlightedCompleteDiffHTML}}
{{- else}}
<p>This diff is too large to display inline.</p>
{{- end}}
</main>
{{- end}}
</div>
<script>
/* airplan:page-js */
</script>
{{- if and .HasMermaid (not .NoExternalAssets)}}
<script>window.__AIRPLAN_MERMAID_THEMES__={{.MermaidThemeJSON}};</script>
<script type="module" referrerpolicy="no-referrer">
/* airplan:mermaid-js */
</script>
{{- end}}
</body>
</html>
