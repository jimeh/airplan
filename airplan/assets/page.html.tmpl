<!-- airplan:icon-templates -->
{{- define "airplan-document-breadcrumb-items" -}}
  {{- if gt (len .Pages) 1}}
  <a class="document-breadcrumb-root" href="{{.Entrypoint}}" aria-label="Document bundle" title="Document bundle">{{template "airplan-icon-bundle"}}</a><span class="document-breadcrumb-separator" aria-hidden="true">/</span>
  {{- else}}
  <span class="document-breadcrumb-root" aria-label="Document" title="Document">{{template "airplan-icon-file"}}</span>
  {{- end}}
  <span class="document-breadcrumb-path">
  {{- range $index, $segment := .CurrentPageBreadcrumbs}}
    {{- if $index}}<span class="document-breadcrumb-separator" aria-hidden="true">/</span>{{end}}
    <span class="document-breadcrumb-segment">{{$segment}}</span>
  {{- end}}
  </span>
{{- end -}}
{{- define "airplan-page-navigation-items" -}}
{{- range .}}
  {{- if .IsDirectory}}
    <li class="pages-directory{{if .Current}} is-current{{end}}">
      <div class="pages-directory-label" title="{{.Path}}">{{template "airplan-icon-directory"}}<span>{{.Name}}</span></div>
      <ol class="pages-list-nested">
        {{- template "airplan-page-navigation-items" .Children}}
      </ol>
    </li>
  {{- else}}
    <li class="pages-page{{if .Current}} is-current{{end}}">
      <a href="{{.URL}}"{{if .Current}} aria-current="page"{{end}}>
        <span class="page-title">{{.Title}}</span>
        <code class="page-path">{{.Name}}</code>
      </a>
    </li>
  {{- end}}
{{- end}}
{{- end -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
{{- if or (eq .Format "md") .VersionsPath}}
<meta name="airplan-versions" content="{{if .VersionsPath}}{{.VersionsPath}}{{else}}.airplan-versions.json{{end}}">
{{- if .Revision}}
<meta name="airplan-revision" content="{{.Revision}}">
<meta name="airplan-revision-chain" content="{{.RevisionChainID}}">
<meta name="airplan-page-path" content="{{.CurrentPage.Path}}">
<meta name="airplan-entrypoint" content="{{.Entrypoint}}">
{{- end}}
{{- end}}
{{- if not .Indexable}}
<meta name="robots" content="noindex, nofollow">
{{- end}}
<title>{{.Title}}</title>
<script>window.__AIRPLAN_THEME_CATALOG__={{.ThemeCatalogJSON}};</script>
<script>
/* airplan:theme-init-js */
</script>
<style>
/* airplan:page-css */
{{.ThemeCSS}}
{{.SyntaxCSS}}
</style>
</head>
<body>
<div class="page-shell{{if gt (len .Pages) 1}} bundle-page{{end}}">
<div class="top-controls">
<nav class="toolbar" aria-label="Document controls">
{{- if gt (len .Pages) 1}}
  <button type="button" class="pages-trigger js-only" hidden
    aria-label="Open pages" aria-controls="pages-popover">{{template "airplan-icon-pages"}}<span>Pages</span></button>
{{- end}}
  <div class="document-breadcrumb toolbar-breadcrumb toolbar-context toolbar-context-document" title="{{.CurrentPage.Path}}">{{template "airplan-document-breadcrumb-items" .}}</div>
  <span class="toolbar-context toolbar-context-history">Bundle history</span>
{{- if or (and (eq .Format "md") .HighlightedSourceHTML) .SourcePath}}
  <div class="file-actions toolbar-actions{{if not .SourcePath}} js-only{{end}}"{{if not .SourcePath}} hidden{{end}}>
{{- if and (eq .Format "md") .HighlightedSourceHTML}}
  <button type="button" class="copy-source js-only" hidden
    aria-label="Copy markdown" title="Copy markdown">{{template "airplan-icon-copy"}}{{template "airplan-icon-copied"}}{{template "airplan-icon-failed"}}<span class="action-label">Copy</span></button>
{{- end}}
{{- if .SourcePath}}
  <a class="download" href="{{.SourcePath}}" download
    aria-label="Download {{if eq .Format "md"}}markdown{{else}}source{{end}}"
    title="Download {{if eq .Format "md"}}markdown{{else}}source{{end}}">{{template "airplan-icon-download"}}<span>Download</span></a>
  <a class="raw" href="{{.SourcePath}}"
    aria-label="Open raw {{if eq .Format "md"}}markdown{{else}}source{{end}}"
    title="Open raw {{if eq .Format "md"}}markdown{{else}}source{{end}}">{{template "airplan-icon-source"}}<span>Raw</span></a>
{{- end}}
  </div>
{{- end}}
{{- if or .AppearanceEnabled .FixedNavbarEnabled}}
<!-- airplan:theme-toggle -->
{{- end}}
</nav>
</div>
{{- if gt (len .Pages) 1}}
<nav class="pages-nav" id="pages" aria-label="Pages">
  <p class="rail-title">Pages</p>
  <ol class="pages-list">
    {{- template "airplan-page-navigation-items" .PageNavigation}}
  </ol>
</nav>
{{- end}}
{{- if .TOC}}
<nav class="toc" id="toc" aria-label="Table of contents">
  <p class="rail-title toc-title">{{if gt (len .Pages) 1}}On this page{{else}}Contents{{end}}</p>
  <ol class="toc-list">
  {{- range .TOC}}
    <li class="toc-level-{{.Level}}"><a href="#{{.ID}}">{{.Text}}</a></li>
  {{- end}}
  </ol>
</nav>
{{- end}}
<header class="document-header">
  <p class="document-breadcrumb document-breadcrumb-header">{{template "airplan-document-breadcrumb-items" .}}</p>
  <div class="document-heading-row">
    <h1>{{.Title}}</h1>
  </div>
{{- if or (and (eq .Format "md") .HighlightedSourceHTML) .Revision}}
  <section class="view-controls" aria-label="Document view and revision">
    <div class="revision-controls{{if not .Revision}} js-only{{end}}" data-revision-controls role="group" aria-label="Revision controls"{{if not .Revision}} hidden{{end}}>
    {{- if .Revision}}
    {{- if and (gt .Revision 1) (gt (len .Pages) 1)}}
    <a class="all-changes-link" href="{{.AllChangesPath}}">{{template "airplan-icon-changes"}}<span>All changes</span></a>
    {{- end}}
    <p class="revision-heading" data-revision-heading>Revision {{.Revision}}{{if .RevisionCount}} of {{.RevisionCount}}{{end}}</p>
    {{- end}}
    </div>
  {{- if or (and (eq .Format "md") .HighlightedSourceHTML) (and (eq .Format "txt") .Revision)}}
    <div class="viewtoggle mode-toggle js-only" hidden>
      <button type="button" class="active" data-view="rendered"
        aria-pressed="true" aria-label="{{if eq .Format "md"}}Read{{else}}Source{{end}} view"
        title="{{if eq .Format "md"}}Read{{else}}Source{{end}} view">{{if eq .Format "md"}}{{template "airplan-icon-rendered"}}{{else}}{{template "airplan-icon-source"}}{{end}}<span>{{if eq .Format "md"}}Read{{else}}Source{{end}}</span></button>
      {{- if eq .Format "md"}}
      <button type="button" data-view="source" aria-pressed="false"
        aria-label="Source view" title="Source view">{{template "airplan-icon-source"}}<span>Source</span></button>
      {{- end}}
      {{- if .PageChanged}}
      <button type="button" data-view="changes" aria-pressed="false"
        aria-label="Changes view" title="Changes from revision {{.PreviousRevision}}">{{template "airplan-icon-changes"}}<span>Changes</span></button>
      {{- end}}
    </div>
  {{- end}}
  </section>
{{- end}}
</header>
<main class="content{{if .Headings}}{{with index .Headings 0}}{{if and .IsTitle (eq $.Title .Text)}} has-leading-title{{end}}{{end}}{{end}}" id="rendered">
{{- if and (eq .Format "txt") .SourceName}}
<div class="filehead"><code>{{.SourceName}}</code></div>
{{- end}}
{{- if and (eq .Format "md") .HighlightedFrontMatterHTML}}
<details class="frontmatter">
  <summary>Frontmatter <span>{{.FrontMatterFormat}}</span></summary>
  {{.HighlightedFrontMatterHTML}}
</details>
{{- end}}
{{.RenderedHTML}}
{{- if gt (len .Pages) 1}}
{{- $current := .CurrentPage}}
{{- $previous := .CurrentPage}}
{{- $next := .CurrentPage}}
{{- $foundCurrent := false}}
{{- $foundNext := false}}
{{- range .Pages}}
  {{- if .Current}}
    {{- $foundCurrent = true}}
  {{- else if not $foundCurrent}}
    {{- $previous = .}}
  {{- else if not $foundNext}}
    {{- $next = .}}
    {{- $foundNext = true}}
  {{- end}}
{{- end}}
<nav class="page-sequence" aria-label="Page sequence">
  {{- if ne $previous.Path $current.Path}}
  <a class="page-sequence-link page-sequence-previous" href="{{$previous.URL}}">
    <span class="page-sequence-direction">Previous</span>
    <span class="page-sequence-title">{{$previous.Title}}</span>
  </a>
  {{- end}}
  {{- if ne $next.Path $current.Path}}
  <a class="page-sequence-link page-sequence-next" href="{{$next.URL}}">
    <span class="page-sequence-direction">Next</span>
    <span class="page-sequence-title">{{$next.Title}}</span>
  </a>
  {{- end}}
</nav>
{{- end}}
</main>
{{- if .PageChanged}}
<main class="content changes-view" id="changes" hidden>
<header class="diff-view-header">
  <h1 class="changes-heading">Changes to {{.CurrentPage.Path}} from revision {{.PreviousRevision}}</h1>
  <a class="raw-diff diff-action" href="{{.DiffPath}}">{{template "airplan-icon-source"}}<span>Open raw diff</span></a>
</header>
{{- if .HighlightedPageDiffHTML}}
{{.HighlightedPageDiffHTML}}
{{- else}}
<p>This diff is too large to display inline.</p>
{{- end}}
</main>
{{- end}}
{{- if and (eq .Format "md") .HighlightedSourceHTML}}
<main class="content source-view" id="source" hidden>
<p class="source-heading">{{template "airplan-icon-source"}}<span>Markdown source</span></p>
{{.HighlightedSourceHTML}}
</main>
{{- end}}
{{- if .HasCompleteDiff}}
<main class="content all-changes-view" data-airplan-all-changes hidden>
<header class="complete-diff-header">
  <nav class="complete-diff-navigation" aria-label="All changes actions">
    <p class="complete-diff-breadcrumb"><a class="all-changes-back" href="{{.Entrypoint}}">{{template "airplan-icon-back"}}<span>Back to {{.CurrentPage.Path}}</span></a><span aria-hidden="true">/</span><span>Revision {{.PreviousRevision}} to {{.Revision}}</span></p>
    <div class="diff-view-header">
      <h1 tabindex="-1">All changes from revision {{.PreviousRevision}}</h1>
      <a class="raw-diff diff-action" href="{{.DiffPath}}">{{template "airplan-icon-source"}}<span>Open raw diff</span></a>
    </div>
  </nav>
  <div class="complete-diff-meta">
    <span>Complete bundle report</span>
    <div class="revision-controls js-only" data-revision-controls role="group" aria-label="Revision controls" hidden>
      <p class="revision-heading" data-revision-heading>Revision {{.Revision}}{{if .RevisionCount}} of {{.RevisionCount}}{{end}}</p>
    </div>
  </div>
</header>
{{- if .HighlightedCompleteDiffHTML}}
{{.HighlightedCompleteDiffHTML}}
{{- else}}
<p>This diff is too large to display inline.</p>
{{- end}}
</main>
{{- end}}
</div>
<script>
/* airplan:page-js */
</script>
{{- if and .HasMermaid (not .NoExternalAssets)}}
<script>window.__AIRPLAN_MERMAID_THEMES__={{.MermaidThemeJSON}};</script>
<script type="module" referrerpolicy="no-referrer">
/* airplan:mermaid-js */
</script>
{{- end}}
</body>
</html>
